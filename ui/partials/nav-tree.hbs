{{#if navigation.length}}
<ul class="nav-list">
  {{#each navigation}}
  <li class="nav-item{{#if (eq ./url @root.page.url)}} is-current-page{{/if}}{{#if ./navTypology}} has-nav-typology{{/if}}" data-depth="{{or ../level 0}}"{{#if ./navTypology}} data-nav-typology="{{./navTypology.id}}"{{/if}}>
    {{#if ./content}}
    {{#if ./items.length}}
    <button class="nav-item-toggle"></button>
    {{/if}}
    {{#if ./url}}
    <a class="nav-link" href="
      {{~#if (eq ./urlType 'internal')}}{{{relativize ./url}}}
      {{~else}}{{{./url}}}{{~/if}}">
      {{#if ./navTypology}}
      <svg class="nav-typology-icon nav-typology-icon--{{./navTypology.id}}" aria-hidden="true"><use href="{{{uiRootPath}}}/img/nav-typology.svg#{{./navTypology.spriteId}}"/></svg>
      {{/if}}
      <span class="nav-text">{{{./content}}}</span>
    </a>
    {{else}}
    <span class="nav-text">
      {{#if ./navTypology}}
      <svg class="nav-typology-icon nav-typology-icon--{{./navTypology.id}}" aria-hidden="true"><use href="{{{uiRootPath}}}/img/nav-typology.svg#{{./navTypology.spriteId}}"/></svg>
      {{/if}}
      <span class="nav-typology-label">{{{./content}}}</span>
    </span>
    {{/if}}
    {{/if}}
{{> nav-tree navigation=./items level=(increment ../level)}}
  </li>
  {{/each}}
</ul>
{{/if}}
