{
  "name": "@antora-supplemental/nav-typology",
  "version": "0.1.8",
  "description": "Antora extension: solid SVG typology icons for sidebar nav (typed leaves/sections; component roots off by default)",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./plugin-api": "./lib/plugin-api.js",
    "./lib/enrich-navigation": "./lib/enrich-navigation.js",
    "./lib/resolve-typology": "./lib/resolve-typology.js",
    "./lib/strip-emoji": "./lib/strip-emoji.js",
    "./lib/typologies": "./lib/typologies.js"
  },
  "files": [
    "lib/**/*",
    "ui/**/*",
    "README.adoc",
    "CHANGELOG.adoc",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "license": "MIT",
  "keywords": [
    "antora",
    "antora-extension",
    "navigation",
    "icons",
    "typology",
    "sidebar"
  ],
  "homepage": "https://github.com/antora-supplemental/nav-typology",
  "bugs": {
    "url": "https://github.com/antora-supplemental/nav-typology/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antora-supplemental/nav-typology.git"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@antora/site-generator": ">=3.1.0"
  },
  "packageManager": "pnpm@10.30.3"
